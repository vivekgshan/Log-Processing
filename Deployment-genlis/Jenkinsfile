pipeline {
    agent any

    parameters {
        string(name: 'LOG_COLLECTOR_IP', defaultValue: '127.0.0.1', description: 'Log Collector IP Address')
        choice(name: 'REMOVE_LOGGENERATOR_IMAGE', choices: ['no', 'yes'], description: 'Remove loggenerator image?')
        choice(name: 'REMOVE_LOGLISTENER_IMAGE', choices: ['no', 'yes'], description: 'Remove loglistener image?')
    }

    environment {
        PROJECT_DIR = "Log-Processing"
        BACKEND_DIR = "${WORKSPACE}/BACKEND"
        DEPLOY_DIR  = "${WORKSPACE}/Deployment-genlis"
        MONITOR_COMPOSE = "docker-compose-monitoring.yml"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'dev-cloud', url: 'https://github.com/vivekgshan/Log-Processing.git'
            }
        }

        stage('Show Current Docker State') {
            steps {
                script {
                    echo "==== Current Docker Containers ===="
                    sh 'docker ps -a || true'

                    echo "==== Current Docker Images ===="
                    sh 'docker images || true'
                }
            }
        }

        stage('Shutdown App Stack') {
            steps {
                dir("${DEPLOY_DIR}") {
                    script {
                        echo "Shutting down application stack..."
                        sh 'docker-compose down || true'
                    }
                }
            }
        }

        stage('Remove old images if requested') {
            steps {
                script {
                    if (params.REMOVE_LOGGENERATOR_IMAGE == 'yes') {
                        sh 'docker rmi -f loggenerator:latest || true'
                    }
                    if (params.REMOVE_LOGLISTENER_IMAGE == 'yes') {
                        sh 'docker rmi -f loglistener:latest || true'
                    }
                }
            }
        }

        stage('Build loggenerator & loglistener') {
            steps {
                script {
                    echo "Building loggenerator image..."
                    sh "docker build -t loggenerator:latest ${BACKEND_DIR}/loggenerator"

                    echo "Building loglistener image..."
                    sh "docker build -t loglistener:latest ${BACKEND_DIR}/loglistener"

                    echo "Cleaning dangling images..."
                    sh 'docker image prune -f || true'
                }
            }
        }

        stage('Deploy App Stack') {
            steps {
                dir("${DEPLOY_DIR}") {
                    script {
                        echo "Starting app stack..."
                        withEnv(["LOG_COLLECTOR_IP=${params.LOG_COLLECTOR_IP}"]) {
                            sh 'docker-compose up -d --build --force-recreate'
                        }
                    }
                }
            }
        }

        stage('Restart Monitoring Stack') {
            steps {
                dir("${DEPLOY_DIR}") {
                    script {
                        echo "Restarting monitoring stack..."
                        sh "docker-compose -f ${MONITOR_COMPOSE} down || true"
                        sh "docker-compose -f ${MONITOR_COMPOSE} up -d --build --force-recreate"
                    }
                }
            }
        }

        stage('Verify Services') {
            steps {
                sh 'docker ps | grep prometheus || true'
                sh 'docker ps | grep grafana || true'
                sh 'docker ps | grep loki || true'
                sh 'docker ps | grep promtail || true'
                sh 'docker ps | grep node-exporter || true'
                sh 'docker ps | grep cadvisor || true'
                sh 'docker ps | grep loggenerator || true'
                sh 'docker ps | grep loglistener || true'
            }
        }
    }

    post {
        always {
            echo "==== Final Docker Containers ===="
            sh 'docker ps -a || true'

            echo "==== Final Docker Images ===="
            sh 'docker images || true'
        }
        success {
            echo "✅ Application + Monitoring stack deployed successfully!"
        }
        failure {
            echo "❌ Deployment failed. Check logs!"
        }
    }
}
