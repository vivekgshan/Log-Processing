pipeline {
    agent any

    parameters {
        string(name: 'BRANCH', defaultValue: 'dev-cloud-banu', description: 'Git branch to build')
        string(name: 'DOCKERHUB_REPO', defaultValue: 'pansura/demo', description: 'DockerHub repo')
        choice(name: 'CLEAN_IMAGES', choices: ['no', 'yes'], description: 'Prune old images before build?')
        choice(name: 'CLEAN_CONTAINERS', choices: ['no', 'yes'], description: 'Prune old containers before build?')

        // ✅ Checkbox parameter with "all" option
        extendedChoice(
            name: 'SERVICES_TO_BUILD',
            type: 'PT_CHECKBOX',
            multiSelectDelimiter: ',',
            value: 'all,logcollector,logerrorpersistor,logdebugpersistor,logwarnpersistor,loginfopersistor,loganalyser',
            description: 'Select "all" OR one/more specific services to build & push',
            defaultValue: 'all'
        )
    }

    environment {
        BACKEND_DIR = "BACKEND"
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.BRANCH}", url: 'https://github.com/vivekgshan/Log-Processing.git'
            }
        }

        stage('Clean Up Old Stack') {
            steps {
                dir("${BACKEND_DIR}") {
                    script {
                        sh 'docker compose -f docker-compose.yaml down || true'
                        if (params.CLEAN_IMAGES == 'yes') {
                            sh 'docker image prune -af || true'
                        }
                        if (params.CLEAN_CONTAINERS == 'yes') {
                            sh 'docker container prune -f || true'
                        }
                    }
                }
            }
        }

        stage('Prepare Configs') {
            steps {
                dir("${BACKEND_DIR}") {
                    script {
                        sh '''
                            if [ -d prometheus.yml ]; then rm -rf prometheus.yml; fi
                            if [ ! -f prometheus.yml ]; then
                                echo "❌ prometheus.yml not found"
                                exit 1
                            fi
                            ls -l prometheus.yml
                            file prometheus.yml || true
                        '''
                    }
                }
            }
        }

        stage('Build & Push Selected Services') {
            steps {
                dir("${BACKEND_DIR}") {
                    script {
                        withCredentials([usernamePassword(credentialsId: 'dockerhub',
                                                          usernameVariable: 'DOCKERHUB_USER',
                                                          passwordVariable: 'DOCKERHUB_PASS')]) {
                            sh 'echo "$DOCKERHUB_PASS" | docker login -u "$DOCKERHUB_USER" --password-stdin'

                            def selected = params.SERVICES_TO_BUILD.tokenize(',')

                            // ✅ Handle "all" logic
                            if (selected.contains("all")) {
                                selected = ['logcollector','logerrorpersistor','logdebugpersistor','logwarnpersistor','loginfopersistor','loganalyser']
                            }

                            for (svc in selected) {
                                echo "🚀 Building ${svc}..."
                                sh "docker compose -f docker-compose.yaml build ${svc}"

                                echo "📦 Tagging and pushing ${svc}..."
                                sh """
                                    docker tag backend-${svc}:latest ${params.DOCKERHUB_REPO}:${svc}
                                    docker push ${params.DOCKERHUB_REPO}:${svc}
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy New Stack') {
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'docker compose -f docker-compose.yaml up -d'
                }
            }
        }
    }

    post {
        always {
            sh 'docker ps -a || true'
            sh 'docker images || true'
        }
    }
}
